# Copy to .env (make env). Environment variables only; never commit .env.
# Host tools (migrations, ingest CLI, eval, tests) use these; containers override host names.
DATABASE_URL=postgresql+asyncpg://hopper:hopper@127.0.0.1:5432/sift
MODELS_URL=http://127.0.0.1:8100
HOPPER_URL=http://127.0.0.1:8000
FILE_STORE=data/files
LOG_LEVEL=INFO

# Sift's tenant in Hopper. make hopper-tenant creates it and fills these two in.
HOPPER_API_KEY=
HOPPER_SIGNING_SECRET=
# The Hopper platform admin that make hopper-tenant logs in as (created if missing).
# Development values only.
HOPPER_ADMIN_EMAIL=admin@sift.local
HOPPER_ADMIN_PASSWORD=dev-only-admin-password
